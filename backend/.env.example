MONGO_URL=
DB_NAME=
JWT_SECRET=

# Required for devotee OTP login (SMS + Email channels) and the admin
# "Send Email Alert" feature (newsletter subscribers). Get an authkey from
# https://control.msg91.com, subscribe to the Email service, and verify a
# sending domain before this will work.
MSG91_AUTH_KEY=
MSG91_EMAIL_DOMAIN=
MSG91_EMAIL_FROM=
# Optional - defaults to spjrsd_generic_transactional. Only needed once that
# template clears MSG91's manual review; until then, OTP email still works
# via their pre-approved global_otp template.
MSG91_EMAIL_TEMPLATE_SLUG=

# Required for devotee OTP login via WhatsApp - direct Meta Cloud API, no
# MSG91 involved. WHATSAPP_OTP_TEMPLATE_NAME must match an approved Meta
# "authentication" category template.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_OTP_TEMPLATE_NAME=

# Required for the inbound WhatsApp chatbot webhook (app/routes/whatsapp.py).
# WHATSAPP_VERIFY_TOKEN is a string you make up yourself and enter in Meta's
# App Dashboard under WhatsApp > Configuration > Webhooks - it must match
# exactly on both sides. META_APP_SECRET is the app's secret from App
# Dashboard > Settings > Basic; used to verify each webhook delivery is
# genuinely from Meta (X-Hub-Signature-256). Leaving it unset skips that
# check with a warning rather than failing closed.
WHATSAPP_VERIFY_TOKEN=
META_APP_SECRET=

# Shared secret checked on POST /api/cron/panchangam-digest and
# /api/cron/review-agent (the X-Cron-Secret header) - the GitHub Actions
# workflows in .github/workflows/ call these on a schedule. Must match the
# CRON_SECRET repository secret in GitHub Actions.
CRON_SECRET=

# Google Business Profile - shared by news/live-blog syndication
# (app/services/syndication.py) and the review reply agent
# (app/services/review_agent.py). Needs Google's API access explicitly
# granted (a Cloud project, OAuth consent, and an access request Google
# reviews) before any of this does anything.
GBP_ACCOUNT_ID=
GBP_LOCATION_ID=
GBP_CLIENT_ID=
GBP_CLIENT_SECRET=
GBP_REFRESH_TOKEN=

# Optional. Used by the review reply agent (app/services/review_agent.py) to
# draft a reply that addresses what a review actually says, via the Claude
# API. Left unset, it falls back to a plain template keyed by star rating -
# the agent still runs, replies are just more generic. Get a key at
# https://console.anthropic.com.
ANTHROPIC_API_KEY=

# Devotee "Sign in with Google" / "Sign up with Google". Create an OAuth 2.0
# Client ID at https://console.cloud.google.com/apis/credentials (Web
# application), add the site's origin(s) under "Authorized JavaScript
# origins" (e.g. https://cheruvugattu.online and http://localhost:3000 for
# dev). Must match REACT_APP_GOOGLE_CLIENT_ID in frontend/.env - it's the
# same Client ID on both sides. Google Sign-In stays inactive until this is set.
GOOGLE_CLIENT_ID=
