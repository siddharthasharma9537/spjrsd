# Copy to .env on the office machine (never commit the real file - it holds
# database credentials). See docs/LOCAL_MIRROR_SYNC.md for the full design.

# Read-only connection string to the production database. Use a dedicated
# DB user scoped to read-only access, not the backend's read-write user.
CLOUD_MONGO_URI=mongodb+srv://spjrsd_mirror_readonly:<password>@<cluster-host>/spjrsd?readPreference=secondaryPreferred

# Connection string for the local mirror database on this machine.
LOCAL_MONGO_URI=mongodb://localhost:27017/spjrsd

# Where dump snapshots are stored before being restored (also kept as a
# short-lived local backup history).
BACKUP_DIR=/opt/spjrsd-mirror/backups

# How many days of old snapshots to keep before deleting them.
RETENTION_DAYS=14

# Optional: sends a WhatsApp alert on sync failure, reusing the same Meta
# Cloud API credentials as the devotee-facing bot (see backend/.env.example).
ALERT_WHATSAPP_TO=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
