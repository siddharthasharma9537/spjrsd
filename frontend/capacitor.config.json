{
  "appId": "online.cheruvugattu.app",
  "appName": "SPJRS Devasthanam",
  "webDir": "build",
  "server": {
    "hostname": "cheruvugattu.online",
    "androidScheme": "https",
    "iosScheme": "https"
  },
  "ios": {
    "contentInset": "always"
  },
  "plugins": {
    "SplashScreen": {
      "launchAutoHide": true,
      "backgroundColor": "#621B00"
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#621B00"
    },
    "SocialLogin": {
      "providers": {
        "google": true,
        "facebook": false,
        "apple": false,
        "twitter": false
      }
    }
  }
}
