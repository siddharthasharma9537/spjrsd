# Base URL of the FastAPI backend, WITHOUT a trailing slash and WITHOUT /api.
# src/lib/api.js appends /api itself.
#
# Baked in at build time by Create React App, so a production build must be made
# with this set - changing it later requires a rebuild, not just a redeploy.
#
# Local development against a backend on port 8000:
REACT_APP_BACKEND_URL=http://localhost:8000

# Production example:
# REACT_APP_BACKEND_URL=https://api.cheruvugattu.online
#
# Leave empty to call same-origin /api (correct when a reverse proxy fronts both
# the static site and the backend on one domain).

# Devotee "Sign in/up with Google" button. Same OAuth Client ID as backend's
# GOOGLE_CLIENT_ID. Leave empty to hide the Google button.
REACT_APP_GOOGLE_CLIENT_ID=

# Native Google Sign-In inside the Android/iOS apps (frontend/src/lib/nativeGoogleAuth.js).
# REACT_APP_GOOGLE_CLIENT_ID above is reused as the required Android "Web
# client" ID; this one is an additional "iOS" type OAuth client (Google Cloud
# Console > Credentials > Create Credentials > OAuth client ID > iOS), needed
# only so iOS's native Google Sign-In SDK can drive its sign-in sheet. See
# MOBILE_APP_SETUP.md. Leave empty to fall back to the web-embedded button on
# iOS (Android works with just REACT_APP_GOOGLE_CLIENT_ID above).
REACT_APP_GOOGLE_IOS_CLIENT_ID=
